{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reminder",
  "version": "1.1.3",
  "identifier": "asia.remind.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Reminder",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Reminder",
        "url": "popup.html",
        "width": 400,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self'; connect-src 'self' https://remind.asia https://commons.wikimedia.org ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "noti.vn",
    "copyright": "Copyright (c) noti.vn",
    "category": "Productivity",
    "shortDescription": "Reminder - focus at work, healthy habits, what to eat today",
    "longDescription": "Reminder desktop: scheduled and interval reminders plus random food and drink pickers, delivered as small popups in the corner of your screen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://remind.asia/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QjBERjgyNzJENjIzMDQKUldRRUk5WnlndCt3MUFuYWNCWXJqaVhLRmc1a0o3cHRDRStjbGlKaXdYbngyQTZla1pQZXBYWXYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
